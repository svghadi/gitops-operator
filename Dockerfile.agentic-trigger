FROM golang:1.26 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
COPY argocd-operator/ argocd-operator/
RUN go mod download
COPY cmd/agentic-trigger/ cmd/agentic-trigger/
COPY internal/agentic/ internal/agentic/
COPY internal/ai/trigger/ internal/ai/trigger/
ARG TARGETARCH
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-X main.commit=${COMMIT}" \
    -o agentic-trigger ./cmd/agentic-trigger/

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/agentic-trigger .
USER 65532:65532
ENTRYPOINT ["/agentic-trigger"]
